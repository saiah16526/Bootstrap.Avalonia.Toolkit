<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib">
	
  <Styles.Resources>
    <SolidColorBrush x:Key="BsBlue" Color="#0d6efd" />
    <SolidColorBrush x:Key="BsIndigo" Color="#6610f2" />
    <SolidColorBrush x:Key="BsPurple" Color="#6f42c1" />
    <SolidColorBrush x:Key="BsPink" Color="#d63384" />
    <SolidColorBrush x:Key="BsRed" Color="#dc3545" />
    <SolidColorBrush x:Key="BsOrange" Color="#fd7e14" />
    <SolidColorBrush x:Key="BsYellow" Color="#ffc107" />
    <SolidColorBrush x:Key="BsGreen" Color="#198754" />
    <SolidColorBrush x:Key="BsTeal" Color="#20c997" />
    <SolidColorBrush x:Key="BsCyan" Color="#0dcaf0" />
    <SolidColorBrush x:Key="BsBlack" Color="#000000" />
    <SolidColorBrush x:Key="BsWhite" Color="#ffffff" />

    <SolidColorBrush x:Key="BsGray" Color="#6c757d" />
    <SolidColorBrush x:Key="BsGrayDark" Color="#343a40" />
    <SolidColorBrush x:Key="BsGray100" Color="#f8f9fa" />
    <SolidColorBrush x:Key="BsGray200" Color="#e9ecef" />
    <SolidColorBrush x:Key="BsGray300" Color="#dee2e6" />
    <SolidColorBrush x:Key="BsGray400" Color="#ced4da" />
    <SolidColorBrush x:Key="BsGray500" Color="#adb5bd" />
    <SolidColorBrush x:Key="BsGray600" Color="#6c757d" />
    <SolidColorBrush x:Key="BsGray700" Color="#495057" />
    <SolidColorBrush x:Key="BsGray800" Color="#343a40" />
    <SolidColorBrush x:Key="BsGray900" Color="#212529" />

    <SolidColorBrush x:Key="BsPrimary" Color="#0d6efd" />
    <SolidColorBrush x:Key="BsSecondary" Color="#6c757d" />
    <SolidColorBrush x:Key="BsSuccess" Color="#198754" />
    <SolidColorBrush x:Key="BsInfo" Color="#0dcaf0" />
    <SolidColorBrush x:Key="BsWarning" Color="#ffc107" />
    <SolidColorBrush x:Key="BsDanger" Color="#dc3545" />
    <SolidColorBrush x:Key="BsLight" Color="#f8f9fa" />
    <SolidColorBrush x:Key="BsDark" Color="#212529" />

    <SolidColorBrush x:Key="BsPrimaryTextEmphasis" Color="#052c65" />
    <SolidColorBrush x:Key="BsSecondaryTextEmphasis" Color="#2b2f32" />
    <SolidColorBrush x:Key="BsSuccessTextEmphasis" Color="#0a3622" />
    <SolidColorBrush x:Key="BsInfoTextEmphasis" Color="#055160" />
    <SolidColorBrush x:Key="BsWarningTextEmphasis" Color="#664d03" />
    <SolidColorBrush x:Key="BsDangerTextEmphasis" Color="#58151c" />
    <SolidColorBrush x:Key="BsLightTextEmphasis" Color="#495057" />
    <SolidColorBrush x:Key="BsDarkTextEmphasis" Color="#495057" />

    <SolidColorBrush x:Key="BsPrimaryBgSubtle" Color="#cfe2ff" />
    <SolidColorBrush x:Key="BsSecondaryBgSubtle" Color="#e2e3e5" />
    <SolidColorBrush x:Key="BsSuccessBgSubtle" Color="#d1e7dd" />
    <SolidColorBrush x:Key="BsInfoBgSubtle" Color="#cff4fc" />
    <SolidColorBrush x:Key="BsWarningBgSubtle" Color="#fff3cd" />
    <SolidColorBrush x:Key="BsDangerBgSubtle" Color="#f8d7da" />
    <SolidColorBrush x:Key="BsLightBgSubtle" Color="#fcfcfd" />
    <SolidColorBrush x:Key="BsDarkBgSubtle" Color="#ced4da" />

    <SolidColorBrush x:Key="BsPrimaryBorderSubtle" Color="#9ec5fe" />
    <SolidColorBrush x:Key="BsSecondaryBorderSubtle" Color="#c4c8cb" />
    <SolidColorBrush x:Key="BsSuccessBorderSubtle" Color="#a3cfbb" />
    <SolidColorBrush x:Key="BsInfoBorderSubtle" Color="#9eeaf9" />
    <SolidColorBrush x:Key="BsWarningBorderSubtle" Color="#ffe69c" />
    <SolidColorBrush x:Key="BsDangerBorderSubtle" Color="#f1aeb5" />
    <SolidColorBrush x:Key="BsLightBorderSubtle" Color="#e9ecef" />
    <SolidColorBrush x:Key="BsDarkBorderSubtle" Color="#adb5bd" />

    <FontFamily x:Key="BsFontSansSerif">"Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, Sans-Serif</FontFamily>
    <FontFamily x:Key="BsFontMonospace">"SF Mono", Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", Monospace</FontFamily>

    <FontFamily x:Key="BsBodyFontFamily">"Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, Sans-Serif</FontFamily>
    <system:Double x:Key="BsBodyFontSize">14</system:Double>
    <FontWeight x:Key="BsBodyFontWeight">Normal</FontWeight>
    <system:Double x:Key="BsBodyLineHeight">24</system:Double>

    <SolidColorBrush x:Key="BsBodyColor" Color="#212529" />
    <SolidColorBrush x:Key="BsBodyBg" Color="#ffffff" />
    
    <SolidColorBrush x:Key="BsSecondaryColor" Color="#54595d" />
    <SolidColorBrush x:Key="BsSecondaryBg" Color="#e9ecef" />
    
    <SolidColorBrush x:Key="BsTertiaryColor" Color="#7f7f7f" />
    <SolidColorBrush x:Key="BsTertiaryBg" Color="#f8f9fa" />
    
    <SolidColorBrush x:Key="BsLinkColor" Color="#0d6efd" />
    <SolidColorBrush x:Key="BsLinkHoverColor" Color="#0a58ca" />
    
    <SolidColorBrush x:Key="BsCodeColor" Color="#d63384" />
    
    <SolidColorBrush x:Key="BsHighlightColor" Color="#212529" />
    <SolidColorBrush x:Key="BsHighlightBg" Color="#fff3cd" />
    
    <SolidColorBrush x:Key="BsBorderColor" Color="#dee2e6" />
    <SolidColorBrush x:Key="BsBorderColorTranslucent" Color="#2c2c2c2c" />

    <system:Double x:Key="BsFocusRingWidth">4</system:Double>
    <SolidColorBrush x:Key="BsFocusRingColor" Color="#400d6efd" />

    <SolidColorBrush x:Key="BsFormValidColor" Color="#198754" />
    <SolidColorBrush x:Key="BsFormValidBorderColor" Color="#198754" />
    <SolidColorBrush x:Key="BsFormInvalidColor" Color="#dc3545" />
    <SolidColorBrush x:Key="BsFormInvalidBorderColor" Color="#dc3545" />
  </Styles.Resources>
	
