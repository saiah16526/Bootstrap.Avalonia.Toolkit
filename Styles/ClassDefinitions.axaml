<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Bootstrap.Avalonia.Toolkit.Converters"
        xmlns:behaviors="clr-namespace:Bootstrap.Avalonia.Toolkit.Behaviors">

	<Styles.Resources>
		<converters:ColorBrightnessConverter x:Key="BrightnessConverter" />
	</Styles.Resources>

	<Style Selector="Window.body">
		<Setter Property="Padding" Value="0" />
		<Setter Property="FontFamily" Value="{DynamicResource BsFontSansSerif}" />
		<Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
		<Setter Property="FontWeight" Value="{DynamicResource BodyFontWeight}" />
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />
		<Setter Property="Background" Value="{DynamicResource BsBodyBg}" />
		<Setter Property="TextBlock.TextAlignment" Value="Left" />
		<Setter Property="TextBlock.LineHeight" Value="24" />
	</Style>

	<Style Selector="Separator.hr">
		<Setter Property="Margin" Value="0,16" />
		<Setter Property="Height" Value="1" />
		<Setter Property="Background" Value="{DynamicResource BsBodyColor}" />
		<Setter Property="Opacity" Value="0.25" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>

	<Style Selector="TextBlock.h1, TextBlock.h2, TextBlock.h3, TextBlock.h4, TextBlock.h5, TextBlock.h6">
		<Setter Property="Margin" Value="0,0,0,8" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="LineHeight" Value="19.2" />
		<Setter Property="Foreground" Value="{DynamicResource BsHeadingColor}" />
	</Style>

	<Style Selector="TextBlock.h1">
		<Setter Property="FontSize" Value="40" />
		<Setter Property="LineHeight" Value="48" />
	</Style>

	<Style Selector="TextBlock.h2">
		<Setter Property="FontSize" Value="32" />
		<Setter Property="LineHeight" Value="38.4" />
	</Style>

	<Style Selector="TextBlock.h3">
		<Setter Property="FontSize" Value="28" />
		<Setter Property="LineHeight" Value="33.6" />
	</Style>

	<Style Selector="TextBlock.h4">
		<Setter Property="FontSize" Value="24" />
		<Setter Property="LineHeight" Value="28.8" />
	</Style>

	<Style Selector="TextBlock.h5">
		<Setter Property="FontSize" Value="20" />
	</Style>

	<Style Selector="TextBlock.h6">
		<Setter Property="FontSize" Value="16" />
	</Style>

	<Style Selector="TextBlock.p">
		<Setter Property="Margin" Value="0,0,0,16" />
	</Style>

	<Style Selector="TextBlock.strong, Run.strong">
		<Setter Property="TextElement.FontWeight" Value="SemiBold" />
	</Style>

	<Style Selector="TextBlock.small, Run.small">
		<Setter Property="TextElement.FontSize" Value="14" />
	</Style>

	<Style Selector="TextBlock.mark, Run.mark">
		<Setter Property="TextElement.Background" Value="{DynamicResource BsHighlightBg}" />
		<Setter Property="TextElement.Foreground" Value="{DynamicResource BsHighlightColor}" />
	</Style>

	<Style Selector="Run.sub">
		<Setter Property="BaselineAlignment" Value="Subscript" />
		<Setter Property="FontSize" Value="12" />
	</Style>

	<Style Selector="Run.sup">
		<Setter Property="BaselineAlignment" Value="Superscript" />
		<Setter Property="FontSize" Value="12" />
	</Style>

	<Style Selector="Button.a">
		<Setter Property="Foreground" Value="{DynamicResource BsLinkColor}" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="TextBlock.TextDecorations" Value="Underline" />
	</Style>

	<Style Selector="Button.a:pointerover /template/ ContentPresenter">
		<Setter Property="Foreground" Value="{DynamicResource BsLinkHoverColor}" />
		<Setter Property="Background" Value="Transparent" />
	</Style>

	<Style Selector="TextBlock.code, Run.code, TextBlock.pre">
		<Setter Property="TextElement.FontFamily" Value="{DynamicResource BsFontMonospace}" />
		<Setter Property="TextElement.FontSize" Value="14" />
	</Style>

	<Style Selector="Run.code">
		<Setter Property="Foreground" Value="{DynamicResource BsCodeColor}" />
	</Style>

	<Style Selector="Border.kbd">
		<Setter Property="Background" Value="{DynamicResource BsBodyColor}" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="Padding" Value="6,3" />
	</Style>

	<Style Selector="Border.kbd TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource BsBodyBg}" />
		<Setter Property="FontSize" Value="14" />
	</Style>

	<Style Selector="Border.pre">
		<Setter Property="Margin" Value="0,0,0,16" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>

	<Style Selector="Label">
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style Selector="Button">
		<Setter Property="CornerRadius" Value="0" />
	</Style>

	<Style Selector="TextBox, Button, ComboBox, TextBox.textarea">
		<Setter Property="Margin" Value="0" />
		<Setter Property="FontFamily" Value="{Binding $parent[Window].FontFamily}" />
		<Setter Property="FontSize" Value="{Binding $parent[Window].FontSize}" />
	</Style>

	<Style Selector="Button:not(:disabled)">
		<Setter Property="Cursor" Value="Hand" />
	</Style>

	<Style Selector="TextBox.textarea">
		<Setter Property="AcceptsReturn" Value="True" />
		<Setter Property="TextWrapping" Value="Wrap" />
		<Setter Property="MinHeight" Value="64" />
	</Style>

	<Style Selector="ComboBox">
		<Setter Property="Padding" Value="8,4" />
		<Setter Property="CornerRadius" Value="0" />
	</Style>

	<Style Selector="ComboBox:disabled">
		<Setter Property="Opacity" Value="1" />
	</Style>

	<Style Selector="TextBlock.lead">
		<Setter Property="FontSize" Value="20" />
		<Setter Property="FontWeight" Value="Light" />
	</Style>

	<Style
		Selector="TextBlock.display-1, TextBlock.display-2, TextBlock.display-3, TextBlock.display-4, TextBlock.display-5, TextBlock.display-6">
		<Setter Property="FontWeight" Value="Light" />
		<Setter Property="TextBlock.LineHeight" Value="1.2" />
	</Style>

	<Style Selector="TextBlock.display-1">
		<Setter Property="FontSize" Value="80" />
		<Setter Property="LineHeight" Value="96" />
	</Style>

	<Style Selector="TextBlock.display-2">
		<Setter Property="FontSize" Value="72" />
		<Setter Property="LineHeight" Value="86.4" />
	</Style>

	<Style Selector="TextBlock.display-3">
		<Setter Property="FontSize" Value="64" />
		<Setter Property="LineHeight" Value="76.8" />
	</Style>

	<Style Selector="TextBlock.display-4">
		<Setter Property="FontSize" Value="56" />
		<Setter Property="LineHeight" Value="67.2" />
	</Style>

	<Style Selector="TextBlock.display-5">
		<Setter Property="FontSize" Value="48" />
		<Setter Property="LineHeight" Value="57.6" />
	</Style>

	<Style Selector="TextBlock.display-6">
		<Setter Property="FontSize" Value="40" />
		<Setter Property="LineHeight" Value="48" />
	</Style>

	<Style Selector="StackPanel.blockquote, TextBlock.blockquote">
		<Setter Property="TemplatedControl.Margin" Value="0,0,0,16" />
		<Setter Property="TextElement.FontSize" Value="20" />
	</Style>

	<Style Selector="TextBlock.blockquote-footer">
		<Setter Property="Margin" Value="0,-16,0,16" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="Foreground" Value="{DynamicResource BsSecondary}" />
	</Style>

	<Style Selector="Image.img-fluid">
		<Setter Property="MaxWidth" Value="10000" /> <Setter Property="Stretch" Value="Uniform" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>

	<Style Selector="Border.img-thumbnail">
		<Setter Property="Padding" Value="4" />
		<Setter Property="Background" Value="{DynamicResource BsBodyBg}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BsBorderColor}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="4" />
	</Style>

	<Style Selector="StackPanel.figure">
		<Setter Property="Spacing" Value="8" />
	</Style>

	<Style Selector="TextBlock.figure-caption">
		<Setter Property="FontSize" Value="14" />
		<Setter Property="Foreground" Value="{DynamicResource BsSecondaryColor}" />
	</Style>

	<Style Selector="ContentControl.container, Panel.container, Border.container">
		<Setter Property="Control.HorizontalAlignment" Value="Center" />
		<Setter Property="Control.MaxWidth" Value="1320" />
		<Setter Property="Control.Margin" Value="12,0" />
		<Setter Property="Control.Width" Value="NaN" />
	</Style>

	<Style Selector="ContentControl.container-fluid">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="Padding" Value="12,0" />
	</Style>

	<Style Selector="Label.form-label">
		<Setter Property="Margin" Value="0,0,0,8" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="FontWeight" Value="Normal" />
	</Style>

	<Style Selector="TextBlock.form-text">
		<Setter Property="Margin" Value="0,4,0,0" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="Foreground" Value="{DynamicResource BsSecondaryColor}" />
	</Style>

	<Style Selector="TextBox.form-control">
		<Setter Property="Padding" Value="12,6" /> <Setter Property="Background" Value="{DynamicResource BsBodyBg}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BsBorderColor}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="6" /> <Setter Property="FontSize" Value="16" />
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />

		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="TextBox.form-control:focus /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="#86b7fe" />
		<Setter Property="BoxShadow" Value="0 0 0 4 #400d6efd" />
	</Style>

	<Style Selector="TextBox.form-control-sm">
		<Setter Property="Padding" Value="8,4" />
		<Setter Property="FontSize" Value="14" />
	</Style>

	<Style Selector="TextBox.form-control-lg">
		<Setter Property="Padding" Value="16,8" />
		<Setter Property="FontSize" Value="20" />
	</Style>

	<Style Selector="ComboBox.form-select">
		<Setter Property="Padding" Value="12,6,36,6" /> <Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="CornerRadius" Value="6" />
	</Style>

	<Style Selector="ComboBox.form-select:focus">
		<Setter Property="BorderBrush" Value="#86b7fe" />
	</Style>

	<Style Selector="CheckBox.form-check-input">
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin" Value="0,4,0,0" />
	</Style>

	<Style Selector="CheckBox.form-check-input:checked /template/ Border#NormalRectangle">
		<Setter Property="Background" Value="{DynamicResource BsPrimary}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BsPrimary}" />
	</Style>

	<Style Selector="ToggleSwitch.form-switch">
		<Setter Property="OnContent" Value="" />
		<Setter Property="OffContent" Value="" />
	</Style>

	<Style Selector="Slider.form-range">
		<Setter Property="Background" Value="{DynamicResource BsSecondaryBg}" />
	</Style>

	<Style Selector="Slider.form-range /template/ Thumb">
		<Setter Property="Background" Value="{DynamicResource BsPrimary}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Width" Value="16" />
		<Setter Property="Height" Value="16" />
		<Setter Property="CornerRadius" Value="16" />
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.15" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="Slider.form-range /template/ Thumb:pressed">
		<Setter Property="Background" Value="#b6d4fe" />
	</Style>

	<Style Selector="Slider.form-range /template/ RepeatButton#PART_SelectionRangeBackground">
		<Setter Property="Background" Value="{DynamicResource BsPrimary}" />
		<Setter Property="Height" Value="8" />
		<Setter Property="CornerRadius" Value="8" />
	</Style>

	<Style Selector="TextBox.form-floating">
		<Setter Property="MinHeight" Value="58" />
		<Setter Property="Padding" Value="12,26,12,6" />
	</Style>

	<Style Selector="Border.input-group">
		<Setter Property="BorderBrush" Value="{DynamicResource BsBorderColor}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="ClipToBounds" Value="True" />
		<Setter Property="Background" Value="{DynamicResource BsBodyBg}" />
	</Style>

	<Style Selector="Border.input-group">
		<Setter Property="BorderBrush" Value="{DynamicResource BsBorderColor}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="ClipToBounds" Value="True" />
		<Setter Property="Background" Value="{DynamicResource BsBodyBg}" />
	</Style>

	<Style Selector="Border.input-group > Grid">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
	</Style>

	<Style Selector="Border.input-group-text">
		<Setter Property="Background" Value="{DynamicResource BsTertiaryBg}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BsBorderColor}" />
		<Setter Property="BorderThickness" Value="0,0,1,0" /> <Setter Property="Padding" Value="12,6" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
	</Style>

	<Style Selector="Border.input-group TextBox">
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="CornerRadius" Value="0" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FocusAdorner" Value="{x:Null}" />
		<Setter Property="MinHeight" Value="0" />
	</Style>

	<Style Selector="Border.input-group:focus-within">
		<Setter Property="BorderBrush" Value="#86b7fe" />
		<Setter Property="BoxShadow" Value="0 0 0 4 #400d6efd" />
	</Style>

	<Style Selector="Border.input-group-sm">
		<Setter Property="CornerRadius" Value="4" />
	</Style>

	<Style
		Selector="Border.input-group-sm TextBlock, 
                Border.input-group-sm TextBox, 
                Border.input-group-sm Button, 
                Border.input-group-sm Border">
		<Setter Property="TemplatedControl.Padding" Value="8,4" />
		<Setter Property="TextBlock.FontSize" Value="14" />
	</Style>

	<Style Selector="Border.input-group-lg">
		<Setter Property="CornerRadius" Value="8" />
	</Style>

	<Style
		Selector="Border.input-group-lg TextBlock, 
                Border.input-group-lg TextBox, 
                Border.input-group-lg Button, 
                Border.input-group-lg Border">
		<Setter Property="TemplatedControl.Padding" Value="16,8" />
		<Setter Property="TextBlock.FontSize" Value="20" />
	</Style>

	<Style Selector="Button.btn">
		<Setter Property="Padding" Value="12,6" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="6" /> <Setter Property="Background" Value="Transparent" />
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.15" />
				<BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
				<BrushTransition Property="Foreground" Duration="0:0:0.15" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="Button.btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Foreground" Value="{DynamicResource ButtonHoverForeground}" />
		<Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource ButtonHoverBorder}" />
	</Style>

	<Style Selector="Button.btn:disabled">
		<Setter Property="Opacity" Value="0.65" />
	</Style>

	<Style Selector="Button.btn-primary">
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />
		<Setter Property="Background" Value="{DynamicResource BsPrimary}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BsPrimary}" />
	</Style>

	<Style Selector="Button.btn-primary TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />
	</Style>

	<Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.12" />
			</Setter.Value>
		</Setter>
		<Setter Property="BorderBrush">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.2" />
			</Setter.Value>
		</Setter>
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />
	</Style>

	<Style Selector="Button.btn-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.2" />
			</Setter.Value>
		</Setter>
		<Setter Property="BorderBrush">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.12" />
			</Setter.Value>
		</Setter>
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />
	</Style>

	<Style Selector="Button.btn-secondary">
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />
		<Setter Property="Background" Value="{DynamicResource BsSecondary}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BsSecondary}" />
	</Style>

	<Style Selector="Button.btn-secondary TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />
	</Style>

	<Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.12" />
			</Setter.Value>
		</Setter>
		<Setter Property="BorderBrush">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.2" />
			</Setter.Value>
		</Setter>
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />
	</Style>

	<Style Selector="Button.btn-secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.2" />
			</Setter.Value>
		</Setter>
		<Setter Property="BorderBrush">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.12" />
			</Setter.Value>
		</Setter>
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />
	</Style>

	<Style Selector="Button.btn-success">
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />
		<Setter Property="Background" Value="{DynamicResource BsSuccess}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BsSuccess}" />
	</Style>

	<Style Selector="Button.btn-success TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />
	</Style>

	<Style Selector="Button.btn-success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.12" />
			</Setter.Value>
		</Setter>
		<Setter Property="BorderBrush">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.2" />
			</Setter.Value>
		</Setter>
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />
	</Style>

	<Style Selector="Button.btn-success:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.2" />
			</Setter.Value>
		</Setter>
		<Setter Property="BorderBrush">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.12" />
			</Setter.Value>
		</Setter>
		<Setter Property="Foreground" Value="{DynamicResource BsBodyColor}" />
	</Style>

	<Style Selector="Button.btn-info">
		<Setter Property="Foreground" Value="{DynamicResource BsBlack}" />
		<Setter Property="Background" Value="{DynamicResource BsInfo}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BsInfo}" />
	</Style>

	<Style Selector="Button.btn-info TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource BsBlack}" />
	</Style>

	<Style Selector="Button.btn-info:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.12" />
			</Setter.Value>
		</Setter>
		<Setter Property="BorderBrush">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.2" />
			</Setter.Value>
		</Setter>
		<Setter Property="Foreground" Value="{DynamicResource BsBlack}" />
	</Style>

	<Style Selector="Button.btn-info:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.2" />
			</Setter.Value>
		</Setter>
		<Setter Property="BorderBrush">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.12" />
			</Setter.Value>
		</Setter>
		<Setter Property="Foreground" Value="{DynamicResource BsBlack}" />
	</Style>

	<Style Selector="Button.btn-warning">
		<Setter Property="Foreground" Value="{DynamicResource BsBlack}" />
		<Setter Property="Background" Value="{DynamicResource BsWarning}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BsWarning}" />
	</Style>

	<Style Selector="Button.btn-warning TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource BsBlack}" />
	</Style>

	<Style Selector="Button.btn-warning:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.12" />
			</Setter.Value>
		</Setter>
		<Setter Property="BorderBrush">
			<Setter.Value>
				<Binding Path="Background"
				         RelativeSource="{RelativeSource TemplatedParent}"
				         Converter="{StaticResource BrightnessConverter}"
				         ConverterParameter="-0.2" />
			</Setter.Value>
		</Setter>
		<Setter Property="Foreground" Value="{DynamicResource BsBlack}" />
