	<Style Selector="TemplatedControl.fade">
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Opacity" Duration="0:0:0.15" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="TemplatedControl.fade:not(.show)">
		<Setter Property="Opacity" Value="0" />
	</Style>

	<Style Selector="TemplatedControl.fade.show">
		<Setter Property="Opacity" Value="1" />
	</Style>

	<Style Selector="TemplatedControl.collapse:not(.show)">
		<Setter Property="IsVisible" Value="False" />
	</Style>

	<Style Selector="TemplatedControl.collapse.show">
		<Setter Property="IsVisible" Value="True" />
	</Style>

	<Style Selector="TemplatedControl.collapsing">
		<Setter Property="ClipToBounds" Value="True" />
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Height" Duration="0:0:0.35" Easing="CubicEaseInOut" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="TemplatedControl.collapsing.collapse-horizontal">
		<Setter Property="Height" Value="NaN" />
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Width" Duration="0:0:0.35" Easing="CubicEaseInOut" />
			</Transitions>
		</Setter>
	</Style>

