	</Style>

	<Style
		Selector="ContentControl.fade, Border.fade, Grid.fade, StackPanel.fade, DockPanel.fade, WrapPanel.fade, Canvas.fade, Panel.fade, ItemsControl.fade, ListBox.fade, ListBoxItem.fade, Button.fade, ToggleButton.fade, CheckBox.fade, RadioButton.fade, TextBlock.fade, TextBox.fade, ScrollViewer.fade, Image.fade">
		<Setter Property="Opacity" Value="0" />
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Opacity" Duration="0:0:0.15" />
			</Transitions>
		</Setter>
