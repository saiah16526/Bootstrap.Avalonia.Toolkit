<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. Typography & Text Elements -->
    <Style
        Selector="Control.body.hr.h1.h2.h3.h4.h5.h6.p.strong.abbr.address.small.mark.sub.sup.a.code.kbd.pre.lead.display-1.display-2.display-3.display-4.display-5.display-6.blockquote.blockquote-footer.font-monospace.fs-1.fs-2.fs-3.fs-4.fs-5.fs-6.fst-italic.fst-normal.fw-light.fw-normal.fw-medium.fw-semibold.fw-bold.lh-1.lh-sm.lh-base.lh-lg.text-start.text-center.text-end.text-uppercase.text-lowercase.text-capitalize.text-decoration-underline.text-decoration-line-through.text-wrap.text-nowrap.text-break.text-truncate.font-inter.font-inter-tight.font-roboto.font-jetbrains-mono.font-cursive.icon-fluent.icon-fluent-light.icon-fluent-filled.icon-fa-solid.icon-fa-regular.icon-fa-brand.icon-material-rounded.icon-material-outlined.icon-material-sharp" />

    <!-- 2. Colors (Text, Background, Links) -->
    <Style
        Selector="Control.text-primary.text-secondary.text-muted.text-body-secondary.text-success.text-info.text-warning.text-danger.text-light.text-dark.text-black.text-white.text-black-50.text-white-50.bg-body.bg-body-secondary.bg-body-tertiary.bg-primary.bg-secondary.bg-success.bg-info.bg-warning.bg-danger.bg-light.bg-dark.bg-black.bg-white.bg-transparent.bg-primary-subtle.bg-success-subtle.bg-danger-subtle.bg-warning-subtle.bg-info-subtle.bg-dark-subtle.text-bg-primary.text-bg-secondary.text-bg-success.text-bg-info.text-bg-warning.text-bg-danger.text-bg-light.text-bg-dark.link-primary.link-secondary.link-success.link-info.link-warning.link-danger.link-light.link-dark" />

    <!-- 3. Buttons & Button Groups -->
    <Style
        Selector="Control.btn.btn-primary.btn-secondary.btn-success.btn-danger.btn-warning.btn-info.btn-light.btn-dark.btn-link.btn-outline-primary.btn-outline-secondary.btn-outline-success.btn-outline-danger.btn-outline-warning.btn-outline-info.btn-outline-light.btn-outline-dark.btn-sm.btn-lg.btn-group" />

    <!-- 4. Forms & Inputs -->
    <Style
        Selector="Control.label.textarea.form-label.form-control.form-control-sm.form-control-lg.form-select.form-check-input.form-switch.form-range.form-floating.input-group.input-group-text.input-group-sm.input-group-lg" />

    <!-- 5. Layout, Containers & Spacing (Margins) -->
    <Style
        Selector="Control.container.container-fluid.m-0.mt-0.mb-0.ms-0.me-0.mx-0.my-0.m-1.mt-1.mb-1.ms-1.me-1.mx-1.my-1.m-2.mt-2.mb-2.ms-2.me-2.mx-2.my-2.m-3.mt-3.mb-3.ms-3.me-3.mx-3.my-3.m-4.mt-4.mb-4.ms-4.me-4.mx-4.my-4.m-5.mt-5.mb-5.ms-5.me-5.mx-5.my-5" />

    <!-- 6. Padding & Alignment -->
    <Style
        Selector="Control.p-0.pt-0.pb-0.ps-0.pe-0.px-0.py-0.p-1.pt-1.pb-1.ps-1.pe-1.px-1.py-1.p-2.pt-2.pb-2.ps-2.pe-2.px-2.py-2.p-3.pt-3.pb-3.ps-3.pe-3.px-3.py-3.p-4.pt-4.pb-4.ps-4.pe-4.px-4.py-4.p-5.pt-5.pb-5.ps-5.pe-5.px-5.py-5.align-self-top.align-self-middle.align-self-bottom.align-self-stretch.align-self-start.align-self-center.align-self-end.gap-0.gap-1.gap-2.gap-3.gap-4.gap-5" />

    <!-- 7. Borders & Rounding -->
    <Style
        Selector="Control.border.border-primary.border-secondary.border-success.border-info.border-warning.border-danger.border-dark.border-black.border-white.border-0.border-1.border-2.border-3.border-4.border-5.border-top-0.border-top-1.border-top-2.border-top-3.border-top-4.border-top-5.border-bottom-0.border-bottom-1.border-bottom-2.border-bottom-3.border-bottom-4.border-bottom-5.border-start-0.border-start-1.border-start-2.border-start-3.border-start-4.border-start-5.border-end-0.border-end-1.border-end-2.border-end-3.border-end-4.border-end-5.rounded-0.rounded-1.rounded-2.rounded-3.rounded-4.rounded-5.rounded-pill.rounded-top-0.rounded-top-1.rounded-top-2.rounded-top-3.rounded-top-4.rounded-top-5.rounded-bottom-0.rounded-bottom-1.rounded-bottom-2.rounded-bottom-3.rounded-bottom-4.rounded-bottom-5.rounded-start-0.rounded-start-1.rounded-start-2.rounded-start-3.rounded-start-4.rounded-start-5.rounded-end-0.rounded-end-1.rounded-end-2.rounded-end-3.rounded-end-4.rounded-end-5" />

    <!-- 8. Components, Visibility & Utilities -->
    <Style
        Selector="Control.card.card-header.card-body.card-title.card-subtitle.card-text.card-footer.img-fluid.img-thumbnail.figure.figure-caption.fade.show.opacity-0.opacity-25.opacity-50.opacity-75.opacity-100.overflow-auto.overflow-hidden.overflow-scroll.overflow-x-auto.overflow-x-hidden.overflow-x-scroll.overflow-y-auto.overflow-y-hidden.overflow-y-scroll.visible.invisible.z-n1.z-0.z-1.z-2.z-3" />

</Styles>